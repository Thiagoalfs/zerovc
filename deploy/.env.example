# ==============================================================
# ZeroVC - Variáveis de Ambiente do Servidor (Template de Produção)
# ==============================================================
# Copie este arquivo para .env na VPS:
# cp .env.example .env
# Em seguida, edite o arquivo .env com valores seguros!

# 1. Domínios (Traefik / Coolify com SSL Let's Encrypt automático)
DOMAIN=zerovc.safiroko.xyz
LIVEKIT_DOMAIN=livekit.safiroko.xyz

# 2. Banco de Dados PostgreSQL Interno
POSTGRES_DB=zerovc
POSTGRES_USER=zerovc_user
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE_AQUI

# 3. Autenticação & Criptografia (JWT Secret de 32+ caracteres)
JWT_SECRET=TROQUE_POR_UM_HASH_ALEATORIO_SEGURO_AQUI

# 4. Servidor de Voz WebRTC (LiveKit API Keys)
LIVEKIT_API_KEY=livekit_key_aleatoria
LIVEKIT_API_SECRET=livekit_secret_muito_seguro_e_longo

