# ==========================================
# ZeroVC - Variáveis de Ambiente do Servidor
# ==========================================

# 1. Banco de Dados PostgreSQL (Seu Container Docker)
# Formato: postgres://<USUARIO>:<SENHA>@<HOST_OU_IP>:<PORTA>/<NOME_BANCO>?sslmode=disable
DATABASE_URL=postgres://zerovc_user:zerovc_password_change_me@postgres:5432/zerovc?sslmode=disable

# 2. Chave de Segurança JWT (Gere uma chave aleatória longa de 32+ caracteres)
JWT_SECRET=zerovc_super_secret_jwt_key_32bytes_long

# 3. Porta HTTP da API ZeroVC
PORT=8080

# 4. Servidor de Voz WebRTC (LiveKit)
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_key_change_in_production
