# ==============================================================================
# ZeroVC - Exemplo de Variáveis de Ambiente para Deploy (Docker Compose)
# ==============================================================================
# Copie este arquivo para .env na pasta deploy/ e preencha com seus valores reais:
#   cp .env.example .env
# ==============================================================================

# Domínios gerenciados pelo Traefik / Reverse Proxy
DOMAIN=zerovc.seudominio.xyz
LIVEKIT_DOMAIN=livekit.seudominio.xyz

# IP público da VPS / Servidor onde o LiveKit está rodando (necessário para WebRTC ICE Candidates)
LIVEKIT_NODE_IP=192.0.2.1

# Banco de Dados PostgreSQL
POSTGRES_DB=zerovc
POSTGRES_USER=zerovc_user
POSTGRES_PASSWORD=sua_senha_segura_postgres_aqui

# Autenticação e Segurança do Backend
JWT_SECRET=gere_um_jwt_secret_longo_e_aleatorio_minimo_32_caracteres

# Credenciais do Servidor LiveKit
LIVEKIT_API_KEY=zerovc_livekit_key
LIVEKIT_API_SECRET=gere_uma_secret_longa_e_segura_para_o_livekit
