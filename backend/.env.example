# Configurações do Servidor ZeroVC
PORT=8080
WEB_DIR=./web

# Banco de Dados PostgreSQL
DATABASE_URL=postgres://zerovc:zerovc_dev_password@localhost:5432/zerovc?sslmode=disable

# Segredos de Autenticação e Sessão
JWT_SECRET=seu_jwt_secret_super_seguro_aqui

# LiveKit (Voz e Vídeo WebRTC)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Riot Games API Key (League of Legends Slash Commands)
# Obtenha sua chave em: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
