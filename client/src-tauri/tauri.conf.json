{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroVC",
  "version": "1.1.10",
  "identifier": "xyz.safiroko.zerovc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZeroVC",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "additionalBrowserArgs": "--js-flags=--max-old-space-size=256"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https: http://127.0.0.1:* blob: data:; media-src 'self' https: http://127.0.0.1:* blob: data:; font-src 'self' https: data:; connect-src 'self' https://zerovc.safiroko.xyz wss://zerovc.safiroko.xyz https://*.safiroko.xyz wss://*.safiroko.xyz https://*.livekit.cloud wss://*.livekit.cloud http://127.0.0.1:* ws://127.0.0.1:*; frame-src 'self' https://challenges.cloudflare.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zerovc"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Thiagoalfs/zerovc/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RDcyOUJBRTdDRUE0OUEKUldTYXBNN251aW5YdHp0NVNmY1RWd2thWGxaK2lIa2tJZnlvYlJsTW8yVlJpZVFzbU9sZFoyZFEK"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
