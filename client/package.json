{
  "name": "zerovc-client",
  "version": "1.1.7",
  "description": "ZeroVC",
  "homepage": "https://zerovc.safiroko.xyz",
  "author": "Thiago <contato@zerovc.safiroko.xyz>",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"const fs=require('fs'),path=require('path'); const copyDir=(src,dest)=>{ if(!fs.existsSync(dest)) fs.mkdirSync(dest,{recursive:true}); for(const entry of fs.readdirSync(src,{withFileTypes:true})){ const s=path.join(src,entry.name),d=path.join(dest,entry.name); if(entry.name==='downloads') continue; if(entry.isDirectory()){ copyDir(s,d); } else { fs.copyFileSync(s,d); } } }; if(fs.existsSync('../backend/web/assets')){ const cur=new Set(fs.readdirSync('dist/assets')); for(const f of fs.readdirSync('../backend/web/assets')){ if(!cur.has(f) && f!=='minecraft.webp') try { fs.unlinkSync(path.join('../backend/web/assets',f)); } catch{} } } copyDir('dist','../backend/web');\"",
    "build:apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "test:frontend-m2": "tsx scripts/test-frontend-m2.ts",
    "test:frontend-m3": "tsx -r ./scripts/test-setup-worker.ts scripts/test-frontend-m3.ts",
    "test:e2ee-spike": "tsx scripts/test-e2ee-spike.ts",
    "test:e2ee-adversarial": "tsx scripts/test-adversarial-crypto.ts",
    "test:livekit-gate": "tsx -r ./scripts/test-setup-worker.ts scripts/test-livekit-gate-adversarial.ts",
    "test:livekit-m4": "tsx scripts/test-livekit-m4.ts",
    "test:callkeys-adversarial": "tsx scripts/challenger-m4-adversarial.ts",
    "test:channels-m5": "tsx -r ./scripts/test-setup-worker.ts scripts/test-channels-m5.ts",
    "test:recovery-m6": "tsx scripts/test-recovery-m6.ts",
    "test:desktop-bridge": "tsx scripts/test-desktop-bridge.ts",
    "test:e2e": "tsx tests/e2e/runner.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust": "tauri dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@kinsh/vodozemac-wasm": "^0.4.2",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "gsap": "^3.15.1",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "livekit-client": "^2.1.2",
    "lucide-react": "^0.372.0",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "zustand": "^4.5.2"
  }
}
